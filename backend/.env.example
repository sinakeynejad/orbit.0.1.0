# Optional: the desktop app can start without this file; configure via Settings.
LLM_PROVIDER=ollama
LLM_MODEL=
# LLM_API_KEY=
# VOICE_API_KEY=
# API_TOKEN=<random 32+ character token for standalone server usage>
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1000
# WORKSPACE_DIR=C:/Users/your-name/Desktop/assistant-workspace
# ALLOWED_APPLICATIONS={"notepad":"C:/Windows/System32/notepad.exe"}
